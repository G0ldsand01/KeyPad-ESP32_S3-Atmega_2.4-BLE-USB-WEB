---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const callbackUrl = Astro.url.searchParams.get('callbackUrl') ?? '/dashboard';
const mode = Astro.url.searchParams.get('mode') ?? 'login';
const title = 'Connexion | FlexPad';
---

<Layout {title} site>
  <div class="page-content auth-page">
    <main class="content-section auth-page__main">
      <h1 class="page-title">Compte FlexPad</h1>
      <p class="page-lead">Connexion ou inscription pour accéder au tableau de bord.</p>

      <div class="auth-switch" role="tablist" aria-label="Connexion ou inscription">
        <button type="button" class="auth-switch__tab" id="tab-login" role="tab" aria-controls="panel-login" aria-selected="true">
          Connexion
        </button>
        <button type="button" class="auth-switch__tab" id="tab-register" role="tab" aria-controls="panel-register" aria-selected="false">
          Inscription
        </button>
      </div>

      <section class="auth-panel" id="panel-login" role="tabpanel" aria-labelledby="tab-login">
      <form class="auth-form" id="login-form" novalidate>
        <div class="form-group">
          <label for="login-email">Courriel</label>
          <input type="email" id="login-email" name="email" class="form-control-like" required autocomplete="email" />
        </div>
        <div class="form-group">
          <label for="login-password">Mot de passe</label>
          <input type="password" id="login-password" name="password" class="form-control-like" required autocomplete="current-password" />
        </div>
        <p class="auth-form__error" id="login-error" hidden></p>
        <button type="submit" class="btn-primary">Se connecter</button>
      </form>
      </section>

      <section class="auth-panel" id="panel-register" role="tabpanel" aria-labelledby="tab-register" hidden>
        <form class="auth-form" id="register-form" novalidate>
          <div class="form-group">
            <label for="register-name">Nom</label>
            <input type="text" id="register-name" name="name" class="form-control-like" autocomplete="name" />
          </div>
          <div class="form-group">
            <label for="register-email">Courriel</label>
            <input type="email" id="register-email" name="email" class="form-control-like" required autocomplete="email" />
          </div>
          <div class="form-group">
            <label for="register-password">Mot de passe</label>
            <input type="password" id="register-password" name="password" class="form-control-like" required autocomplete="new-password" minlength="6" />
            <span class="form-hint">Minimum 6 caractères.</span>
          </div>
          <p class="auth-form__error" id="register-error" hidden></p>
          <button type="submit" class="btn-secondary">Créer le compte</button>
        </form>
      </section>

      <div class="back-link">
        <a href="/">Retour à l’accueil</a>
      </div>
    </main>
  </div>
</Layout>

<script define:vars={{ callbackUrl, mode }}>
  const form = document.getElementById('login-form');
  const errEl = document.getElementById('login-error');
  const registerForm = document.getElementById('register-form');
  const registerErrEl = document.getElementById('register-error');
  const tabLogin = document.getElementById('tab-login');
  const tabRegister = document.getElementById('tab-register');
  const panelLogin = document.getElementById('panel-login');
  const panelRegister = document.getElementById('panel-register');

  function setMode(next) {
    const isRegister = next === 'register';
    tabLogin?.setAttribute('aria-selected', isRegister ? 'false' : 'true');
    tabRegister?.setAttribute('aria-selected', isRegister ? 'true' : 'false');
    tabLogin?.classList.toggle('is-active', !isRegister);
    tabRegister?.classList.toggle('is-active', isRegister);
    if (panelLogin) panelLogin.hidden = isRegister;
    if (panelRegister) panelRegister.hidden = !isRegister;

    const url = new URL(window.location.href);
    url.searchParams.set('mode', isRegister ? 'register' : 'login');
    window.history.replaceState({}, '', url);

    const focusId = isRegister ? 'register-email' : 'login-email';
    const el = document.getElementById(focusId);
    if (el instanceof HTMLElement) el.focus();
  }

  tabLogin?.addEventListener('click', () => setMode('login'));
  tabRegister?.addEventListener('click', () => setMode('register'));
  setMode(mode === 'register' ? 'register' : 'login');

  /** Connexion credentials sans `auth-astro/client` : leur `signIn` fait `new URL(data.url)` sans base, ce qui jette si Auth renvoie une URL relative (succès). */
  async function signInCredentials(email, password, nextUrl) {
    const prefix = '/api/auth';
    const csrfRes = await fetch(`${prefix}/csrf`, { credentials: 'same-origin' });
    if (!csrfRes.ok) throw new Error(`CSRF HTTP ${csrfRes.status}`);
    const csrfJson = await csrfRes.json();
    const csrfToken = csrfJson?.csrfToken;
    if (!csrfToken) throw new Error('Jeton CSRF manquant');

    const res = await fetch(`${prefix}/callback/credentials`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Auth-Return-Redirect': '1',
      },
      credentials: 'same-origin',
      body: new URLSearchParams({
        email: String(email ?? ''),
        password: String(password ?? ''),
        csrfToken,
        callbackUrl: nextUrl,
      }),
    });

    let data;
    try {
      data = await res.json();
    } catch (parseErr) {
      console.error('[login] JSON invalide', parseErr);
      throw new Error('Réponse serveur invalide');
    }

    const rawUrl = typeof data?.url === 'string' ? data.url : '';
    let target = nextUrl;
    let authError = null;
    if (rawUrl) {
      try {
        const u =
          rawUrl.startsWith('http://') || rawUrl.startsWith('https://')
            ? new URL(rawUrl)
            : new URL(rawUrl, window.location.origin);
        authError = u.searchParams.get('error');
        target = u.href;
      } catch (urlErr) {
        console.error('[login] URL de redirection invalide', rawUrl, urlErr);
        throw new Error('Redirection invalide');
      }
    }

    if (authError) {
      return { ok: false, error: 'credentials' };
    }
    return { ok: true, redirectTo: target };
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errEl) {
      errEl.hidden = true;
      errEl.textContent = '';
    }
    const fd = new FormData(form);
    const email = fd.get('email');
    const password = fd.get('password');
    const nextUrl = callbackUrl || '/dashboard';
    try {
      const out = await signInCredentials(email, password, nextUrl);
      if (!out.ok) {
        if (errEl) {
          errEl.textContent = 'Courriel ou mot de passe incorrect.';
          errEl.hidden = false;
        }
        return;
      }
      window.location.assign(out.redirectTo);
    } catch (err) {
      console.error('[login]', err);
      if (errEl) {
        errEl.textContent = 'Une erreur est survenue. Réessayez.';
        errEl.hidden = false;
      }
    }
  });

  registerForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (registerErrEl) {
      registerErrEl.hidden = true;
      registerErrEl.textContent = '';
    }
    const fd = new FormData(registerForm);
    const payload = {
      name: String(fd.get('name') || ''),
      email: String(fd.get('email') || ''),
      password: String(fd.get('password') || ''),
    };
    try {
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(payload),
      });
      const j = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (registerErrEl) {
          registerErrEl.textContent = j.error || 'Inscription impossible.';
          registerErrEl.hidden = false;
        }
        return;
      }

      // Auto-login après inscription
      const nextUrl = callbackUrl || '/dashboard';
      const out = await signInCredentials(payload.email, payload.password, nextUrl);
      if (out.ok) window.location.assign(out.redirectTo);
      else if (registerErrEl) {
        registerErrEl.textContent = 'Compte créé, mais connexion impossible. Réessayez.';
        registerErrEl.hidden = false;
      }
    } catch (err) {
      console.error('[register]', err);
      if (registerErrEl) {
        registerErrEl.textContent = 'Une erreur est survenue. Réessayez.';
        registerErrEl.hidden = false;
      }
    }
  });
</script>
