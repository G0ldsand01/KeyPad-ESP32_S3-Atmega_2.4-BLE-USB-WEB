---
import { ViewTransitions } from 'astro:transitions';
import GlassNav from '../components/GlassNav.astro';
import AuthDock from '../components/AuthDock.astro';
import CartWidget from '../components/CartWidget.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  /** Pages vitrine : main.css, fond hero sur toute la page, pied de page commun */
  site?: boolean;
  /** Réutilise le fond déco vitrine (grille/circuits) sans basculer toute la page sur main.css */
  backdrop?: boolean;
}

const { title = "Configuration Macropad", site = false, backdrop = false } = Astro.props;
// Version d’assets stable par déploiement (évite les caches agressifs sur Vercel)
const deployVersion =
  import.meta.env.PUBLIC_ASSET_VERSION ??
  (typeof process !== 'undefined' ? process.env.VERCEL_GIT_COMMIT_SHA : undefined) ??
  (typeof process !== 'undefined' ? process.env.VERCEL_DEPLOYMENT_ID : undefined) ??
  Date.now().toString(36);
const assetVersion = String(deployVersion).slice(0, 16);
const gitCommitSha =
  typeof process !== 'undefined' && process.env.VERCEL_GIT_COMMIT_SHA
    ? String(process.env.VERCEL_GIT_COMMIT_SHA)
    : undefined;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script is:inline>
    (function(){try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);}catch(e){}})();
  </script>
  <title>{title}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23666'><rect x='2' y='6' width='20' height='12' rx='1' fill='none' stroke='currentColor' stroke-width='2'/><rect x='5' y='9' width='2' height='2'/><rect x='9' y='9' width='2' height='2'/><rect x='13' y='9' width='2' height='2'/><rect x='17' y='9' width='2' height='2'/></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  {site ? (
    <link rel="stylesheet" href="/styles/main.css" />
  ) : (
    <link rel="stylesheet" href="/styles/global.css" />
  )}
  {!site && backdrop && (
    <link rel="stylesheet" href="/styles/site-backdrop.css" />
  )}
  {!site && backdrop && (
    <link rel="stylesheet" href="/styles/site-header-chrome.css" />
  )}
  <link rel="stylesheet" href="/styles/glass-nav.css" />
  <meta name="flexpad-build" content={assetVersion} />
  {gitCommitSha && <meta name="flexpad-git-sha" content={gitCommitSha} />}
  <ViewTransitions />
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.563.0/dist/umd/lucide.min.js" crossorigin="anonymous"></script>
</head>
<body>
  <span
    id="flexpad-build-marker"
    hidden
    aria-hidden="true"
    data-version={assetVersion}
    data-git-sha={gitCommitSha ?? ''}
  />
  <GlassNav />
  {(site || backdrop) && (
    <div class="site-header-actions">
      <AuthDock />
      <ThemeToggle variant="dock" />
      <CartWidget />
    </div>
  )}
  {(site || backdrop) ? (
    <div class="main-page">
      <div class="main-page-backdrop" aria-hidden="true">
        <div class="main-page-backdrop__stage">
          <div class="parallax-layer parallax-layer--deep" data-speed="0.3"></div>
          <div class="parallax-layer parallax-layer--grid" data-speed="0.5"></div>
          <div class="hero-circuit hero-circuit--1" data-speed="0.38" data-circuit-tilt="-25"></div>
          <div class="hero-circuit hero-circuit--2" data-speed="0.32" data-circuit-tilt="20"></div>
          <div class="hero-circuit hero-circuit--3" data-speed="0.48" data-circuit-tilt="15"></div>
          <div class="hero-circuit hero-circuit--4" data-speed="0.36" data-circuit-tilt="-30"></div>
          <div class="hero-circuit hero-circuit--5" data-speed="0.52" data-circuit-tilt="45"></div>
          <div class="hero-circuit hero-circuit--6" data-speed="0.28" data-circuit-tilt="-15"></div>
          <div class="hero-circuit hero-circuit--7" data-speed="0.44" data-circuit-tilt="35"></div>
        </div>
      </div>
      <div class="main-page-content">
        <div class="main-page-main">
          <slot />
        </div>
        {site && <SiteFooter />}
      </div>
    </div>
  ) : (
    <slot />
  )}
  <script src={`/scripts/theme-toggle.js?v=${assetVersion}`} type="module"></script>
  <script src={`/scripts/main.js?v=${assetVersion}`} type="module"></script>
  <script src={`/scripts/cart.js?v=${assetVersion}`} type="module"></script>
  <script src={`/scripts/checkout-page.js?v=${assetVersion}`} type="module"></script>
  <script src={`/scripts/contact-page.js?v=${assetVersion}`} type="module"></script>
  <script src={`/scripts/config-page.js?v=${assetVersion}`} type="module"></script>
</body>
</html>
