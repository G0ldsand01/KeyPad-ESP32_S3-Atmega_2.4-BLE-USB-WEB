---
const deployVersion =
  import.meta.env.PUBLIC_ASSET_VERSION ??
  (typeof process !== 'undefined' ? process.env.VERCEL_GIT_COMMIT_SHA : undefined) ??
  (typeof process !== 'undefined' ? process.env.VERCEL_DEPLOYMENT_ID : undefined) ??
  import.meta.env.BUILD_ID ??
  Date.now().toString(36);
const buildId = String(deployVersion).replace(/[^a-zA-Z0-9]/g, '').slice(0, 8) || 'unknown';
---

<footer class="main-footer">
  <div class="main-footer__inner">
    <p class="main-footer__text">
      <span class="main-footer__copy">©</span>
      <span class="main-footer__brand">FlexPad</span>
      <span class="main-footer__sep" aria-hidden="true">·</span>
      <span class="main-footer__credit">Mathieu Goulet, Créateur</span>
      <span class="main-footer__sep" aria-hidden="true">·</span>
      <span class="main-footer__tagline">BE PRODUCTIVE</span>
      <span class="main-footer__sep" aria-hidden="true">·</span>
      <span class="main-footer__credit">Build {buildId}</span>
    </p>
  </div>
</footer>
