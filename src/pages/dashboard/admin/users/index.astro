---
import Layout from '../../../../layouts/Layout.astro';
import DashboardChrome from '../../../../components/DashboardChrome.astro';
import { getSession } from 'auth-astro/server';
import { db } from '../../../../db';
import { users } from '../../../../db/schema';

export const prerender = false;
const session = await getSession(Astro.request);
if (!session?.user || session.user.role !== 'admin') return Astro.redirect('/dashboard');

const dbEnabled = Boolean(import.meta.env.DATABASE_URL);
const allUsers = dbEnabled ? await db.select().from(users) : [];
const title = 'Admin — Utilisateurs | FlexPad';
---

<Layout {title} site>
  <div class="page-content dashboard-page dashboard-page--chrome">
    <DashboardChrome variant="admin" title="Utilisateurs" subtitle={dbEnabled ? "Comptes enregistrés (Auth + base locale)." : "Base désactivée (démo Vercel) — liste indisponible."} userName={session.user.name ?? session.user.email ?? 'Admin'} userEmail={session.user.email ?? ''} isAdmin={true}>
      <div class="dashboard-card reveal visible">
        <h2 class="dashboard-card__title">Liste ({allUsers.length})</h2>
        <div class="admin-users-table-wrap">
          <table class="admin-orders-table">
            <thead>
              <tr>
                <th>Courriel</th>
                <th>Nom</th>
                <th>Rôle</th>
                <th>Créé le</th>
              </tr>
            </thead>
            <tbody>
              {allUsers.map((u) => (
                <tr>
                  <td>{u.email}</td>
                  <td>{u.name ?? '—'}</td>
                  <td>{u.role === 'admin' ? 'Admin' : 'Client'}</td>
                  <td>{u.createdAt ? new Date(u.createdAt).toLocaleDateString('fr-CA') : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="dashboard-card reveal visible admin-promote-card">
          <h2 class="dashboard-card__title">Rôle admin pour un compte existant</h2>
          <p class="dashboard-note">
            Le compte doit déjà exister (inscription sur <a href="/login">/login</a> ou{' '}
            <code>pnpm db:seed</code>). Ensuite, entre son courriel et choisis le rôle.
          </p>
          <form class="admin-promote-form" id="admin-promote-form">
            <label>
              Courriel
              <input type="email" name="email" required class="form-control-like" placeholder="utilisateur@exemple.com" autocomplete="off" />
            </label>
            <label>
              Rôle
              <select name="role" class="form-control-like">
                <option value="admin">Admin</option>
                <option value="user">Client</option>
              </select>
            </label>
            <button type="submit" class="btn-primary btn-sm">Mettre à jour le rôle</button>
          </form>
          <p class="dashboard-note">
            Première admin en local / Neon : par défaut{' '}
            <code>admin@flexpad.local</code> / <code>flexpad-admin</code> après{' '}
            <code>pnpm db:seed</code> (voir <code>.env.example</code> pour personnaliser).
          </p>
        </div>
    </DashboardChrome>
  </div>
</Layout>

<script>
  document.getElementById('admin-promote-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    if (!(form instanceof HTMLFormElement)) return;
    const fd = new FormData(form);
    const email = String(fd.get('email') || '').trim();
    const role = String(fd.get('role') || 'user');
    try {
      const res = await fetch('/api/admin/promote-user', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, role }),
      });
      const j = await res.json().catch(() => ({}));
      if (!res.ok) {
        alert(j.error || 'Échec');
        return;
      }
      alert('Rôle mis à jour. L’utilisateur doit se déconnecter et se reconnecter.');
      location.reload();
    } catch {
      alert('Erreur réseau');
    }
  });
</script>
