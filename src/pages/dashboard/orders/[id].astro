---
import Layout from '../../../layouts/Layout.astro';
import DashboardChrome from '../../../components/DashboardChrome.astro';
import { getSession } from 'auth-astro/server';
import { and, eq } from 'drizzle-orm';
import { db } from '../../../db';
import { orders } from '../../../db/schema';
import {
  formatCadFromCents,
  parseOrderCartLines,
  parseOrderShipping,
  orderStatusLabelFr,
} from '../../../lib/orders';

export const prerender = false;

const session = await getSession(Astro.request);
if (!session?.user) {
  return Astro.redirect('/login?callbackUrl=/dashboard/orders');
}

const id = Astro.params.id;
if (!id) {
  return Astro.redirect('/dashboard/orders');
}

const dbEnabled = Boolean(import.meta.env.DATABASE_URL);
const [order] = dbEnabled
  ? await db
      .select()
      .from(orders)
      .where(and(eq(orders.id, id), eq(orders.userId, session.user.id)))
      .limit(1)
  : [];

if (!order) {
  return Astro.redirect('/dashboard/orders');
}

const items = parseOrderCartLines(order.cartJson);
const shipping = parseOrderShipping(order.shippingJson);
const title = `Commande ${order.reference} | FlexPad`;
const isAdmin = session.user.role === 'admin';
---

<Layout {title} site>
  <div class="page-content dashboard-page dashboard-page--chrome">
    <DashboardChrome
      variant="user"
      title={`Commande ${order.reference}`}
      subtitle="Détail de votre commande, articles et livraison."
      userName={session.user.name ?? session.user.email ?? 'Utilisateur'}
      userEmail={session.user.email ?? ''}
      isAdmin={isAdmin}
    >
      <div class="order-detail">
        <p class="order-detail__back">
          <a href="/dashboard/orders/">← Mes commandes</a>
        </p>

        <div class="dashboard-card reveal visible order-detail__card">
          <header class="order-detail__head">
            <div>
              <h2 class="dashboard-card__title">{order.reference}</h2>
              <p class="dashboard-note">
                {order.createdAt
                  ? new Date(order.createdAt).toLocaleString('fr-CA')
                  : ''}
                {order.paidAt && (
                  <>
                    {' '}
                    · Payée le {new Date(order.paidAt).toLocaleString('fr-CA')}
                  </>
                )}
              </p>
            </div>
            <span class={`dash-status dash-status--${order.status}`}>{orderStatusLabelFr(order.status)}</span>
          </header>

          <section class="order-detail__section">
            <h3 class="order-detail__h">Articles</h3>
            {items.length === 0 ? (
              <p class="dashboard-note">Aucune ligne d’article enregistrée.</p>
            ) : (
              <ul class="order-detail__lines">
                {items.map((item, idx) => (
                  <li>
                    <div class="order-detail__line-main">
                      <strong>{item.name ?? `Article ${idx + 1}`}</strong>
                      {item.tagline && <span class="order-detail__tag">{item.tagline}</span>}
                    </div>
                    <span>Qté {item.quantity ?? 0}</span>
                    <span class="order-detail__line-price">
                      {formatCadFromCents(Math.round((item.price ?? 0) * (item.quantity ?? 0) * 100))}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section class="order-detail__section">
            <h3 class="order-detail__h">Livraison</h3>
            {!shipping || Object.keys(shipping).length === 0 ? (
              <p class="dashboard-note">Aucune adresse enregistrée.</p>
            ) : (
              <dl class="order-detail__dl">
                {shipping.name && (
                  <>
                    <dt>Nom</dt>
                    <dd>{shipping.name}</dd>
                  </>
                )}
                {shipping.email && (
                  <>
                    <dt>Courriel</dt>
                    <dd>
                      <a href={`mailto:${shipping.email}`}>{shipping.email}</a>
                    </dd>
                  </>
                )}
                {shipping.phone && (
                  <>
                    <dt>Téléphone</dt>
                    <dd>{shipping.phone}</dd>
                  </>
                )}
                {(shipping.address || shipping.city || shipping.postal) && (
                  <>
                    <dt>Adresse</dt>
                    <dd>
                      {[shipping.address, shipping.city, shipping.postal].filter(Boolean).join(', ')}
                    </dd>
                  </>
                )}
              </dl>
            )}
          </section>

          <section class="order-detail__section">
            <h3 class="order-detail__h">Montants</h3>
            <ul class="order-detail__totals">
              <li>
                <span>Sous-total</span>
                <span>{formatCadFromCents(order.subtotalCents)}</span>
              </li>
              <li>
                <span>TPS (5 %)</span>
                <span>{formatCadFromCents(order.tpsCents)}</span>
              </li>
              <li>
                <span>TVQ (9,975 %)</span>
                <span>{formatCadFromCents(order.tvqCents)}</span>
              </li>
              <li class="order-detail__totals--grand">
                <span>Total</span>
                <span>{formatCadFromCents(order.totalCents)}</span>
              </li>
              {order.refundedCents > 0 && (
                <li class="order-detail__totals--refund">
                  <span>Remboursé</span>
                  <span>{formatCadFromCents(order.refundedCents)}</span>
                </li>
              )}
            </ul>
          </section>

          {(order.stripePaymentIntentId || order.stripeCheckoutSessionId) && (
            <section class="order-detail__section">
              <h3 class="order-detail__h">Paiement Stripe</h3>
              <ul class="dashboard-note order-detail__stripe">
                {order.stripePaymentIntentId && (
                  <li>
                    PaymentIntent : <code>{order.stripePaymentIntentId}</code>
                  </li>
                )}
                {order.stripeCheckoutSessionId && (
                  <li>
                    Session Checkout : <code>{order.stripeCheckoutSessionId}</code>
                  </li>
                )}
              </ul>
            </section>
          )}
        </div>
      </div>
    </DashboardChrome>
  </div>
</Layout>
