---
import Layout from '../../layouts/Layout.astro';
---

<Layout site title="Panier | FlexPad - BE PRODUCTIVE">
  <div class="checkout-page">
    <nav class="breadcrumb">
      <a href="/">Accueil</a>
      <span class="separator">/</span>
      <span>Panier</span>
    </nav>

    <div class="checkout-container checkout-container--wide">
      <section class="checkout-step reveal" id="cart-page">
        <h2>Votre panier</h2>
        <p class="contact-aside-note checkout-step-lead">
          Ajustez la quantité ou retirez l’article. Pour supprimer, mettez la quantité à 0 (confirmation).
        </p>

        <div class="checkout-cart-empty" id="cart-page-empty" hidden>
          <p>Votre panier est vide.</p>
          <p class="contact-aside-note">Ajoutez un FlexPad depuis la fiche produit pour poursuivre.</p>
          <a href="/product/" class="btn-primary">Voir le produit</a>
        </div>

        <div id="cart-page-content">
          <div class="cart-item">
            <div class="cart-item-image">
              <div class="numpad-mini"></div>
            </div>
            <div class="cart-item-details">
              <h3>FlexPad</h3>
              <p>Pavé numérique programmable</p>
              <div class="cart-quantity">
                <label for="quantity">Quantité :</label>
                <input type="number" id="quantity" min="0" value="1" />
              </div>
            </div>
            <div class="cart-item-price">
              <span class="unit-price" id="unit-price-label">149,99 $ / unité</span>
              <span class="total-price" id="line-total">149,99 $</span>
            </div>
          </div>

          <div class="cart-actions">
            <a href="/checkout/" class="btn-primary">Commander</a>
            <button type="button" class="btn-danger" id="btn-remove-cart" aria-label="Retirer du panier">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 6h18"/>
                <path d="M8 6V4h8v2"/>
                <path d="M6 6l1 16h10l1-16"/>
                <path d="M10 11v6"/>
                <path d="M14 11v6"/>
              </svg>
              Retirer
            </button>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script is:inline>
    // Page /panier : dépend de window.FlexPadCart (cart.js, chargé après ce bloc). On s’aligne sur flexpad:cart-ready + View Transitions.
    (function () {
      function whenDocumentReady(cb) {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', cb, { once: true });
        } else {
          queueMicrotask(cb);
        }
      }

      var panierAbort = null;

      function initPanierPage() {
        var emptyEl = document.getElementById('cart-page-empty');
        var contentEl = document.getElementById('cart-page-content');
        var qtyInput = document.getElementById('quantity');
        var removeBtn = document.getElementById('btn-remove-cart');
        var lineTotalEl = document.getElementById('line-total');
        if (!contentEl && !emptyEl) return;

        if (panierAbort) panierAbort.abort();
        panierAbort = new AbortController();
        var signal = panierAbort.signal;

        var getCart = function () {
          return window.FlexPadCart && window.FlexPadCart.getCart ? window.FlexPadCart.getCart() : { items: [], total: 0 };
        };
        var formatCad = function (value) {
          return new Intl.NumberFormat('fr-CA', { style: 'currency', currency: 'CAD' }).format(value);
        };
        var syncUI = function () {
          var cart = getCart();
          var hasItems = Array.isArray(cart.items) && cart.items.length > 0;
          if (contentEl) contentEl.hidden = !hasItems;
          if (emptyEl) emptyEl.hidden = hasItems;
          if (qtyInput && hasItems) {
            var item = cart.items.find(function (i) {
              return i.id === 'flexpad';
            });
            if (item) {
              qtyInput.value = String(item.quantity);
              if (lineTotalEl) lineTotalEl.textContent = formatCad(item.price * item.quantity);
            }
          }
        };

        syncUI();

        document.addEventListener('flexpad:cart-updated', syncUI, { signal: signal });

        if (qtyInput) {
          qtyInput.addEventListener(
            'change',
            function () {
              var raw = parseInt(qtyInput.value || '1', 10);
              var q = Number.isFinite(raw) ? Math.max(0, raw) : 1;
              if (q === 0) {
                if (window.FlexPadCart && window.FlexPadCart.showRemoveOverlay) window.FlexPadCart.showRemoveOverlay('flexpad');
                syncUI();
                return;
              }
              if (window.FlexPadCart && window.FlexPadCart.setItemQuantityById) window.FlexPadCart.setItemQuantityById('flexpad', q);
              syncUI();
            },
            { signal: signal }
          );
        }

        if (removeBtn) {
          removeBtn.addEventListener(
            'click',
            function () {
              if (window.FlexPadCart && window.FlexPadCart.showRemoveOverlay) window.FlexPadCart.showRemoveOverlay('flexpad');
            },
            { signal: signal }
          );
        }
      }

      document.addEventListener('astro:page-load', initPanierPage);
      document.addEventListener('flexpad:cart-ready', initPanierPage);
      whenDocumentReady(function () {
        if (window.FlexPadCart) initPanierPage();
      });
    })();
  </script>
</Layout>

